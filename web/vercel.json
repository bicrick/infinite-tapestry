{
 "functions": {
  "api/*.js": {
   "maxDuration": 15
  },
  "api/og.js": {
   "maxDuration": 20,
   "includeFiles": "lib/fonts/**"
  }
 },
 "headers": [
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    },
    {
     "key": "Referrer-Policy",
     "value": "strict-origin-when-cross-origin"
    }
   ]
  },
  {
   "source": "/sw.js",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-cache"
    },
    {
     "key": "Service-Worker-Allowed",
     "value": "/"
    }
   ]
  }
 ],
 "rewrites": [
  {
   "source": "/",
   "has": [
    {
     "type": "query",
     "key": "at",
     "value": "(?<at>\\d+)"
    }
   ],
   "destination": "/api/page?kind=at&at=:at"
  },
  {
   "source": "/u/:handle",
   "destination": "/api/page?kind=u&handle=:handle"
  },
  {
   "source": "/terms",
   "destination": "/terms.html"
  },
  {
   "source": "/admin",
   "destination": "/admin.html"
  },
  {
   "source": "/auth/confirm",
   "destination": "/confirm.html"
  },
  {
   "source": "/s/:id",
   "destination": "/api/share?id=:id"
  },
  {
   "source": "/m/:range",
   "destination": "/api/share?m=:range"
  }
 ]
}