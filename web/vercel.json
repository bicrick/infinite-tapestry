{
 "functions": {
  "api/*.js": {
   "maxDuration": 15
  }
 },
 "headers": [
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    },
    {
     "key": "Referrer-Policy",
     "value": "strict-origin-when-cross-origin"
    }
   ]
  }
 ],
 "rewrites": [
  {
   "source": "/u/:handle",
   "destination": "/profile.html"
  },
  {
   "source": "/s/:id",
   "destination": "/api/share?id=:id"
  }
 ]
}