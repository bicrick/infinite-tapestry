{
 "functions": {
  "api/*.js": {
   "maxDuration": 15
  }
 },
 "headers": [
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    },
    {
     "key": "Referrer-Policy",
     "value": "strict-origin-when-cross-origin"
    }
   ]
  },
  {
   "source": "/sw.js",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-cache"
    },
    {
     "key": "Service-Worker-Allowed",
     "value": "/"
    }
   ]
  }
 ],
 "rewrites": [
  {
   "source": "/auth/confirm",
   "destination": "/confirm.html"
  },
  {
   "source": "/u/:handle",
   "destination": "/profile.html"
  },
  {
   "source": "/s/:id",
   "destination": "/api/share?id=:id"
  },
  {
   "source": "/m/:range",
   "destination": "/api/share?m=:range"
  }
 ]
}