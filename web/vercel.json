{
 "functions": {
  "api/admin.js": {
   "maxDuration": 60
  },
  "api/*.js": {
   "maxDuration": 20,
   "includeFiles": "lib/fonts/**"
  }
 },
 "headers": [
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    },
    {
     "key": "Referrer-Policy",
     "value": "strict-origin-when-cross-origin"
    }
   ]
  },
  {
   "source": "/sw.js",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-cache"
    },
    {
     "key": "Service-Worker-Allowed",
     "value": "/"
    }
   ]
  },
  {
   "source": "/about-img/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=604800, s-maxage=31536000"
    }
   ]
  },
  {
   "source": "/",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-cache, no-store, must-revalidate"
    }
   ]
  },
  {
   "source": "/(.*)\\.html",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-cache, no-store, must-revalidate"
    }
   ]
  },
  {
   "source": "/build.json",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-cache, no-store, must-revalidate"
    }
   ]
  },
  {
   "source": "/config.js",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-cache, no-store, must-revalidate"
    }
   ]
  },
  {
   "source": "/(.*)\\.(js|css)",
   "has": [
    {
     "type": "query",
     "key": "v"
    }
   ],
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  }
 ],
 "rewrites": [
  {
   "source": "/",
   "has": [
    {
     "type": "query",
     "key": "at",
     "value": "(?<at>\\d+)"
    }
   ],
   "destination": "/api/page?kind=at&at=:at"
  },
  {
   "source": "/u/:handle",
   "destination": "/api/page?kind=u&handle=:handle"
  },
  {
   "source": "/terms",
   "destination": "/terms.html"
  },
  {
   "source": "/privacy",
   "destination": "/privacy.html"
  },
  {
   "source": "/admin",
   "destination": "/admin.html"
  },
  {
   "source": "/auth/confirm",
   "destination": "/confirm.html"
  },
  {
   "source": "/s/:id",
   "destination": "/api/share?id=:id"
  },
  {
   "source": "/m/:range",
   "destination": "/api/share?m=:range"
  },
  {
   "source": "/about",
   "destination": "/about.html"
  },
  {
   "source": "/time-machine",
   "destination": "/time-machine.html"
  },
  {
   "source": "/sitemap.xml",
   "destination": "/api/sitemap"
  },
  {
   "source": "/robots.txt",
   "destination": "/api/sitemap?kind=robots"
  }
 ]
}