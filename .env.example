# Local settings for `make dev`, `make health` and the scripts/ops tools. Copy to .env (git-ignored); no quotes.
# Nothing here is needed for `make setup`, `make dev` (mock) or `make test`.
# Production does NOT read this file: GitHub repo secrets are the source of truth and CI syncs them to Vercel and the
# pod (full list with where to get each value: scripts/ci/secrets.json and docs/OPERATIONS.md#secrets).

# --- local worker (`make dev`) ---
PORT=8000
# TAPESTRY_ANTHROPIC_API_KEY=      # optional: real Auto director / idea interpretation (console.anthropic.com > API keys)

# --- talk to the real backends (optional; service-role keys are admin access, keep them off shared machines) ---
# SUPABASE_URL=                    # Supabase > Project Settings > API
# SUPABASE_SERVICE_ROLE_KEY=       # Supabase > Project Settings > API keys (service_role)
# R2_ENDPOINT=                     # Cloudflare R2 > S3 API endpoint
# R2_ACCESS_KEY_ID=                # Cloudflare R2 > Manage API tokens
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_URL=                   # custom domain of the bucket (https://img.infinitetapestry.app); r2.dev also works
# R2_BUCKET=tapestry-strips

# --- ops helpers ---
# POD_ID=                          # skip the pod_state lookup (scripts/ops/pod_health.py)
# RUNPOD_API_KEY=                  # scripts/ops/pod_ssh.py resolves the pod's SSH port with it
# POD_SSH_KEY_FILE=~/.ssh/rp_tapestry   # private half of SSH_PUB in web/lib/gpu.js
# TAPESTRY_GPU_SECRET=             # scripts/gpu.sh on/off/status (= Vercel env GPU_CLI_SECRET)
